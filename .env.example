TELEGRAM_TOKEN=your_telegram_bot_token
CHANNEL_ID=@your_channel_username_or_id
GROUP_ID=-1001234567890
GROQ_API_KEY=your_groq_api_key
# Choose either a single model:
# GROQ_MODEL=llama-3.1-70b-versatile
# Or a priority list (primary first), auto-fallback on deprecations:
GROQ_MODELS=llama-3.1-70b-versatile,llama-3.1-8b-instant
DASHBOARD_PASSWORD=optional_dashboard_password
ADMIN_USER_ID=your_telegram_user_id

# LinkedIn
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token
LINKEDIN_PERSON_URN=urn:li:person:xxxxxxxx
# Optional: LINKEDIN_COMPANY_URN=urn:li:organization:xxxxxxxx

# Discord
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxx/xxxx
DISCORD_USERNAME=RoboBot
# Optional: DISCORD_AVATAR_URL=https://example.com/avatar.png

# Medium
MEDIUM_INTEGRATION_TOKEN=your_medium_token
MEDIUM_USER_ID=your_medium_user_id

# Twitter/X
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
TWITTER_ACCESS_TOKEN=your_twitter_access_token
TWITTER_ACCESS_SECRET=your_twitter_access_secret

# Blogger
BLOGGER_BLOG_ID=your_blog_id_number
# Option 1: Simple API Key (read-only or limited access)
BLOGGER_API_KEY=your_google_api_key
# Option 2: OAuth 2.0 (for full posting capabilities)
BLOGGER_ACCESS_TOKEN=your_oauth_access_token
BLOGGER_REFRESH_TOKEN=your_oauth_refresh_token
BLOGGER_CLIENT_ID=your_google_client_id
BLOGGER_CLIENT_SECRET=your_google_client_secret

# Reddit
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USERNAME=your_reddit_username
REDDIT_PASSWORD=your_reddit_password
REDDIT_USER_AGENT=TechInfluencerBot/1.0
REDDIT_SUBREDDIT=technology

# Facebook
FACEBOOK_PAGE_ACCESS_TOKEN=your_page_access_token
FACEBOOK_PAGE_ID=your_page_id
# Dev.to
DEVTO_API_KEY=your_devto_api_key

# Cloudflare R2 (recommended: stable public URLs for generated images)
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
R2_BUCKET=your_bucket_name
R2_PUBLIC_BASE_URL=https://pub-xxxxxx.r2.dev
# Optional folder prefix inside the bucket
R2_PREFIX=og

# Storj (S3-compatible alternative to R2)
STORJ_ACCESS_KEY_ID=your_storj_access_key
STORJ_SECRET_ACCESS_KEY=your_storj_secret_key
STORJ_ENDPOINT_URL=https://gateway.storjshare.io
STORJ_BUCKET=your_bucket_name
# IMPORTANT: This must be a PUBLIC base URL (linksharing/custom domain) that allows anonymous GET.
STORJ_PUBLIC_BASE_URL=https://link.storjshare.io/s/<share-token>
STORJ_PREFIX=og

# Optional fallback (only if you run your own static image server)
IMAGE_BASE_URL=https://your-image-server.onrender.com